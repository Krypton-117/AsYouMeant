{
  "name": "asyoumeant",
  "version": "0.3.1",
  "description": "Contract-governed development loops aligned to explicit user intent.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": "24.11.1"
  },
  "packageManager": "pnpm@11.19.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "conformance": "node --test dist/test/c12-conformance-runner.test.js",
    "demo:m2": "node scripts/demo-m2.mjs",
    "probe:dsh": "node scripts/probe-dsh.mjs",
    "pack:dsh": "node scripts/pack-dsh.mjs",
    "probe:dsh-package": "node scripts/probe-dsh-package.mjs",
    "release:check": "node scripts/release-check.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:0.3": "pnpm build && node --test dist/test/c16-skill-pool.test.js dist/test/c17-task-local-skill.test.js dist/test/c20-skill-experience-store.test.js dist/test/c21-post-loop-curator.test.js"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "@types/node": "24.1.0",
    "typescript": "7.0.2"
  }
}
